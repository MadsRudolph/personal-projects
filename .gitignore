# Obsidian
.obsidian/
.trash/

# OS Files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
~$*

# ESPHome secrets (contains WiFi passwords, API keys)
secrets.yaml

# Personal workspace files (optional - uncomment if you don't want to share)
# .obsidian/workspace.json
# .obsidian/workspace-mobile.json

# Python
__pycache__/
*.pyc

# Claude Code
.claude/worktrees/
.claude/settings.local.json

# KiCad backups
*-backups/
*.kicad_sch.bak
*.kicad_sch.bak_*
# Editor lock files -- present only while KiCad has the project open
~*.lck

# Windows artifacts
nul
%temp%/

# Tool/session state
logs/
.claude/

# Dependency and build trees -- regenerated by npm/esphome/pip, and the reason
# this repo would otherwise carry ~2.7 GB across ComponentScanner, the plant
# projects and Xiaomi S400.
node_modules/
.esphome/
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
build/
dist/

# Gradle wrapper distribution + caches (ComponentScanner ships a whole Gradle 8.9)
.gradle/
.gradle-dist/
# Vite/Electron renderer build output
dist-renderer/

# KiCad netlist JSON: regenerated from the .kicad_sch by pcb_netlist_json.py
subxo.json

# editor local-history folders
**/.history/

# Blender backups
*.blend1
*.blend2
