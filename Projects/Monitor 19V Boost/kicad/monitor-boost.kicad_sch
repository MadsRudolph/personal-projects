	(text "Power stage and gate drive  (12 V -> L1 -> Q1 / D1 -> 19 V;  SG3524 DRV -> BD139/BD140 totem pole -> Q1)"
		(at 10.16 30.48 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "fcc1d27c-7f50-449d-a3d4-7404503d6573")
	)
	(text "Controller  (SG3524, 100 kHz, voltage mode, type III compensation)"
		(at 33.02 114.3 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "c76420a5-621a-4b0e-9a65-c0ce93613a65")
	)
	(text "Over-voltage shutdown  (trips at ~23 V)"
		(at 223.52 124.46 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "b5e495ba-b0e0-467d-ab41-6478d40119cb")
	)
	(text "Current limit  (CL+ trips at 200 mV = 8 A peak in Q1)"
		(at 223.52 160.02 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "45b09fd4-56cd-4606-86c0-b58dfada653a")
	)
	(text "Power flags"
		(at 10.16 203.2 0)
		(effects
			(font
