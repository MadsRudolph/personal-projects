		)
		(uuid "0a997083-10ad-479b-9b91-636825cea69c")
	)
	(text "Design notes"
		(at 223.52 30.48 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "4f10cfcb-72a4-41bb-ae93-133981a7226b")
	)
	(text "Brief: 19 V / 3 A for a Samsung C27JG5x (needs 19 V 2.53 A) from a 12 V supply of >= 6 A."
		(at 223.52 35.56 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "18c71ab1-3d86-49b0-ab63-778487f77fcc")
	)
	(text "Numbers: calc/boost_design.py.  Switching SPICE check: sim/boost_tran.cir (run sim/run_corners.sh)."
		(at 223.52 39.37 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e6de558f-650d-42bc-970a-526336715016")
	)
	(text ""
		(at 223.52 41.91 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "7462f261-d86b-49d3-b2dd-d537809d7915")
	)
	(text "fsw = 1.30 / (R7 C12) = 100 kHz.  Both SG3524 outputs paralleled -> single-ended drive at fosc."
		(at 223.52 45.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1553d075-d895-4ec0-be5f-0d409b295a19")
	)
	(text "D = 0.39..0.45 (Vin 12.6..11.4 V).  IL: 5.3 A avg, 6.7 A peak worst case."
		(at 223.52 48.26 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a9c3c2a5-a359-477d-8d12-4c4141ba84f8")
	)
	(text "L1 22 uH, Isat >= 9 A: powdered-iron toroid (-26 / -52 mix), NOT plain ferrite.  Measure AL first."
		(at 223.52 52.07 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "83b8a406-115b-4269-bb72-0bc873eed549")
	)
	(text "VOUT = V(IN+) x (1 + R10/R11) = 2.5 V x 7.63 = 19.06 V with RV1 centred; RV1 spans the VREF tolerance."
		(at 223.52 55.88 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "46be519c-0f76-43a7-8e1b-62a1b7e61c18")
	)
	(text "Soft start: C13 on IN+ ramps the reference (tau 2.4 ms), so the loop tracks up with no overshoot."
		(at 223.52 58.42 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "8c7eef4b-5055-4ec8-968e-eaa041ca0ee0")
	)
	(text "Type III: fz 229/260 Hz, fp 9.2/12.2 kHz; crossover ~0.7 kHz, PM >= 67 deg, GM >= 15 dB"
		(at 223.52 62.23 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "72354ce8-007c-417a-918e-60d3db711dee")
	)
	(text "   over Vin 11.4..12.6 V, Iout 1..3 A and 30..150 mOhm ESR per output cap."
		(at 223.52 64.77 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "7102993f-4bcb-4f3e-b3fd-4a5491605f42")
	)
	(text "Q2 and the SG3524 output collectors run from VCC_F (after R6); C9 supplies the gate-charge pulses."
		(at 223.52 68.58 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "40e5d7ac-30d8-4ada-9737-32f3bfcd8621")
	)
	(text "SG3524 error amp is a 2 mS OTA sourcing only ~200 uA: keep the network high-impedance (R12 >= 5k)."
		(at 223.52 72.39 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "73de7c89-e02e-498e-a0cd-d3209521bdbb")
	)
	(text "Current limit: R1||R2 = 50 mOhm, R14/R15 halves it, CL+ threshold 200 mV -> 8 A peak."
		(at 223.52 74.93 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "032c08a5-f089-4e33-b70e-ea6317abec08")
	)
	(text "   A boost has no output short-circuit protection: fuse the 12 V lead (8 A slow)."
		(at 223.52 78.74 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "bb35ba55-035a-4789-9576-51a4b3ce6309")
	)
	(text "OVP: D4 + R16/R17 pull SHUTDOWN high above ~23 V.  D2 (1.5KE24A) clamps if everything else fails."
		(at 223.52 81.28 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "53fe5069-fc82-4e27-ba05-429162e3f2e3")
	)
	(text ""
		(at 223.52 85.09 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "873c1089-44ff-4de8-9bda-f0cf7103d309")
	)
	(text "Layout: Q1 / D1 / C4-C6 / R1-R2 loop as small as possible.  U1 GND and CL- go to the shunt's"
		(at 223.52 88.9 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "0b44507b-1f7a-4a4b-97cf-f7b1711f4df5")
	)
	(text "   ground end (star point), never through the power return.  Q1 and D1 on separate heatsinks,"
		(at 223.52 91.44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "59d0fee0-02aa-4c29-9265-14a135ecd228")
	)
	(text "   or one heatsink with mica + bushings (both tabs are live: drain = SW, cathode = VOUT)."
		(at 223.52 95.25 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2a5e4c29-cd1d-4c5d-ab84-fad2d0f02be2")
	)
	(text "Single-sided board, CNC isolation-milled with a 0.8 mm end mill.  THT only, all pad gaps >= 0.8 mm."
		(at 223.52 97.79 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "35fea190-94df-4e17-9124-df58eacfc20e")
	)
	(text "All electrolytics 50 V.  Electrolytic, 5 W resistor and toroid footprints are provisional: measure the parts before placing."
		(at 223.52 101.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ede13641-4b12-4415-bdfb-7a4ed4449a26")
	)
