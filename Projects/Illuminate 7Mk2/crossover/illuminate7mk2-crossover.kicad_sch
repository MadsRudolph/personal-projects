		)
		(uuid "ad8f1c86-47b8-4e04-944c-08e4e2971361")
	)
	(text "TWEETER BRANCH - Dayton RST28F-4 (4 ohm)"
		(at 38.1 16.51 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "d026c024-a2aa-48f6-990b-dcb63a4da9f4")
	)
	(text "WOOFER BRANCH - Dayton RS180P-8 (8 ohm)"
		(at 38.1 92.71 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "839a84fa-4e41-4ee3-9992-91299d8dcbab")
	)
	(text "IN from Fosi V3 amplifier"
		(at 12.7 66.04 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "12426667-dcef-4418-8f30-6c8798b17361")
	)
	(text "(TPA3255, 48 V rail)"
		(at 12.7 68.58 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "562f0286-deb5-4109-999a-5309791b9126")
	)
	(text "series tank in the branch, not a shunt"
		(at 45.72 60.96 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e0d8fc2d-773a-400e-9a43-25e3275c96f8")
	)
	(text "series tank in the branch, not a shunt"
		(at 121.92 133.35 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "68ea4471-4dfc-4271-86cd-762f1c621638")
	)
	(text "NOTES  -  one board per speaker, build two.   Value field = DTU component shop part number."
		(at 12.7 146.05 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9f9824c2-fc58-42a0-9116-436186323e2a")
	)
	(text "1. GND = IN- , the amplifier's negative speaker terminal and the common return for both drivers."
		(at 12.7 149.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e3b29d75-2e34-4217-858d-158b6a0d3146")
	)
	(text "   It is NOT chassis earth, and the two boards' returns must not be tied to each other."
		(at 12.7 154.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "4df8e8b9-94f8-44ad-baef-f1b44b811c15")
	)
	(text "2. All capacitors are FILM and must be rated >= 63 V, 100 V preferred. The shop lists no voltage"
		(at 12.7 158.75 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ca16da6e-06e9-4b04-a33d-6a1e9548e282")
	)
	(text "   rating, so CHECK THE PRINTING ON THE ACTUAL PARTS before fitting them."
		(at 12.7 162.56 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e71049bb-6fc5-42fe-bf34-d7ba16c9c44a")
	)
	(text "3. Series pairs:   R101+R102 = 9.4 ohm / 10 W (design 10 ohm).   R201+R202 = 20 ohm / 10 W (20)."
		(at 12.7 166.37 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "d3785885-0e2c-4c62-8b42-e6197f0ce209")
	)
	(text "4. Parallel caps:  C102||C103 = 5.5uF (5.6).  C104||C105 = 10.1uF (10).  C201..C205 = 41uF (40)."
		(at 12.7 171.45 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e7645f9e-91c5-4814-b01c-ec216e4bea78")
	)
	(text "                   C206||C207 = 11.5uF (12).  Each part's 'Design value' field holds the original."
		(at 12.7 175.26 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1b3d3cfc-8137-4fb5-bb4d-edf8f2c51043")
	)
	(text "5. L101/L102/L201/L202 are air-core coils, 0.8 mm (20 AWG) wire - self-wound or bought (Dayton"
		(at 12.7 179.07 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "62922abd-9a35-4cc5-aaee-1d62eb0558c3")
	)
	(text "   AC20-20 / AC20-25 / AC20-70 / AC202 or Jantzen Audio equivalents. Target DCR is in Description."
		(at 12.7 184.15 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "5fe5faff-a9d7-41d0-93bb-77be39a9282e")
	)
	(text "6. FOOTPRINTS ARE PROVISIONAL: measure cap lead pitch before routing. Coils mount OFF the board (lead pads only)."
		(at 12.7 187.96 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a7abe022-87a4-4d2a-8410-d09a35c82971")
	)
	(text "7. Single-sided board, CNC isolation-milled with a 0.8 mm end mill. Through-hole only."
		(at 12.7 191.77 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a8eaf5bf-df96-43c3-8708-8b9d64e0df9e")
	)
