	(text "CLK stage  (caliper orange)"
		(at 55.88 29.21 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "038a06b0-54d4-4cb6-a060-f02e91f84875")
	)
	(text "DATA stage  (caliper green)"
		(at 55.88 77.47 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "8a0166b5-a088-432c-b4eb-ff58ac85d5a5")
	)
	(text "BLE Digital Caliper -- protoboard prototype"
		(at 11.43 10.16 0)
		(effects
			(font
				(size 2.2 2.2)
			)
			(justify left bottom)
		)
		(uuid "a337fb9d-46ae-4b16-ada5-2c0f485f91ec")
	)
	(text "Two inverting common-emitter shifters lift the caliper's 0-1.1 V logic to 0-3.3 V."
		(at 11.43 15.24 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "a480e888-d7b3-4fab-8c1a-3a4c26865451")
	)
	(text "Caliper high -> transistor on -> ESP32 pin pulled LOW. That is SHIFTER_INVERTS 1 in config.h."
		(at 11.43 17.78 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "3366be0a-ded2-4d3d-8a7e-333ba9f5c3c0")
	)
	(text "J1 = the four tails off the caliper data port."
		(at 10.16 111.76 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "bea7ddb1-e610-4b51-b4de-ad1746e9982f")
	)
	(text "Identify them by WIRE COLOUR, not by pin number."
		(at 10.16 115.57 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "9a1aa45e-c589-4d93-850e-c43ed567c89c")
	)
	(text "gray is caliper VDD, about 1.08 V: leave it OFF."
		(at 10.16 118.11 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "d35bcaba-d1e2-439e-88b9-fade55cdcf7a")
	)
	(text "Tying gray to 3V3 drives 3.3 V into a 1.1 V rail"
		(at 10.16 120.65 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "428413bc-a928-4a2d-aadb-da817dffb4de")
	)
	(text "and can destroy the caliper."
		(at 10.16 124.46 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "cbf1336d-bba6-4bf2-9be6-15f845db1e6d")
	)
	(text "U1 is a classic ESP32 DevKit (WROOM-32)."
		(at 137.16 109.22 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "ff2c6245-16fd-43d9-a983-35639185e006")
	)
	(text "Pin names match the board silkscreen."
		(at 137.16 111.76 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "7bf21d81-e31d-441a-aa2d-0d524c10d531")
	)
	(text "The X marks are pins the DevKit already"
		(at 137.16 115.57 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "b343151d-ae28-426f-b029-bed0e979ec68")
	)
	(text "handles for you -- do not wire them."
		(at 137.16 119.38 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "961daa9d-d890-43fa-8d84-f6706d9dd258")
	)
	(text "3V3 comes from the DevKit regulator, over USB."
		(at 137.16 121.92 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "505358cc-da01-4072-9c39-e8265ec0e064")
	)
	(text "SW1/SW2 are for BLE mode only -- not needed"
		(at 93.98 137.16 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "73ba4648-b1ba-4b89-b008-0cf1647bcb85")
	)
	(text "for CALIPER_SNIFFER_MODE bring-up."
		(at 93.98 140.97 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "56475c0c-c227-4536-984a-9a39d6f82718")
	)
	(text "BC547 pinout: flat face toward you, legs down,"
		(at 10.16 133.35 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "e29c809c-d412-43af-b786-c9f160da3a9b")
	)
	(text "left to right = C  B  E."
		(at 10.16 137.16 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "fe7e0b84-8f63-4a81-9bb4-b8a858c94658")
	)
	(text "A 2N3904 is E  B  C, the mirror image. If a stage"
		(at 10.16 139.7 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "7c2628a7-1b81-4343-8bbe-53f4bde0e303")
	)
	(text "will not switch, swap the outer two legs."
		(at 10.16 143.51 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "b2c0626e-ed18-4472-95bf-f32eec4116e4")
	)
