	(text "R23/R24 hold SW_A and SW_B near 0 V, standing in for the"
		(at 12.7 195.58 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "cd131069-0c7d-4787-951b-0bde73910cb8")
	)
	(text "low-side FET being on. Without them the switch nodes float up"
		(at 12.7 200.66 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "4b35eae1-f798-47ae-985c-106d0a246498")
	)
	(text "through the driver's own leakage and the bootstrap caps never"
		(at 12.7 205.74 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "f8cd4b54-3d84-40e2-93ee-5f746debcda0")
	)
	(text "charge -- the bridge itself is bench F."
		(at 12.7 210.82 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "d3673b47-8032-46a1-86d5-0016de6e0249")
	)
	(text "The caps start empty and take ~50 us to fill, so read the dead"
		(at 12.7 220.98 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "137ccb54-4e29-4525-a3cc-342421cab68f")
	)
	(text "time from the far end of the run, not the start. Expect ~225 ns"
		(at 12.7 226.06 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "0eec0e8a-8df6-4b1f-b138-dc3f3c10cfcf")
	)
	(text "with both outputs low at each commutation, and G_AH a quarter of"
