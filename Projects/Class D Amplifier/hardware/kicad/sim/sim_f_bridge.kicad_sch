	(text "F  Output bridge, LC filter and Zobel"
		(at 12.7 12.7 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "20965dbe-0d06-4676-9edc-6f9924bf85f8")
	)
	(text "PWM in at a fixed 79 % / 21 % duty"
		(at 55.88 33.02 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "3d33db61-ce7c-4dae-b973-c6bc4cafe817")
	)
	(text "gate driver and bootstrap"
		(at 12.7 111.76 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "47ffd51d-b10e-4585-a16e-9003b4dd5336")
	)
	(text "output bridge"
		(at 193.04 121.92 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "d4599c8e-daff-4c4d-a5f8-a3fdb5fb7138")
	)
	(text "filter, Zobel and a 4 ohm load"
		(at 317.5 132.08 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "0c3594ca-07a0-4833-9d5d-c1b87be4309e")
	)
	(text "Watch OUT_P - OUT_N. At this duty the design should hold about 6.8 V across 4 ohm, which is ~11.7 W, with the carrier residue well under half a volt peak to peak."
		(at 12.7 210.82 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "29552240-e8e4-4e1f-8071-f51d491b8f8e")
	)
	(text "The bridge is real IRF540N cards, body diode included, so the dead-time commutation and its recovery spike are in the result."
		(at 12.7 220.98 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "009f60ea-30e3-48d7-9905-3f7ceb9705c4")
	)
	(text "Plot the DIFFERENCE, not the two outputs. Every part of the filter -- C13, the Zobel, the load -- sits between OUT_P and OUT_N, and nothing connects either of them to ground, so the common mode is unfiltered and swings the full rail. Each output measured to ground therefore runs from -3.8 V to +15.8 V while the load sees a clean 6.8 V. Measure with FROM=150u TO=300u."
		(at 12.7 231.14 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3c7ec9f7-3e73-45d7-a8b4-ca67e59f328c")
	)
	(text ".tran 20n 300u uic"
		(at 12.7 241.3 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "078aa0ce-e1a9-47eb-92f6-fbe19e6792d3")
	)
