	(text "A  Power in and 6 V virtual ground"
		(at 12.7 12.7 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "89d8cbdd-232b-467a-8da1-2e78f68acf34")
	)
	(text "6 V = 12 V / 2, buffered, so every stage shares one quiet reference."
		(at 17.78 91.44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "47d23cf9-58bd-4189-9c69-5466ee6cb6da")
	)
	(text "B  Triangle carrier ~250 kHz  (LM311 Schmitt + TL074 integrator)"
		(at 111.76 12.7 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "42e66ae2-f523-4fda-9a81-6bcd16d9498b")
	)
	(text "f = Vsw / (8 R C):  R4+RV1 ~ 5k6 with C12 470p gives 250 kHz;  R5/R6 set the +/-2 V window about 6 V"
		(at 114.3 86.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "97c18141-01b9-4231-9e48-62e83a686cf9")
	)
	(text "H  Indicator and bring-up"
		(at 304.8 12.7 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "2974b8e2-baff-451c-bdb5-ef7a0342f5b7")
	)
	(text "Test points TP1..TP5 are solder lugs on TRI, PWM_A,"
		(at 332.74 25.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "6aa6a482-d186-4c87-991a-a13a56df8e26")
	)
	(text "both switching nodes and the filtered output."
		(at 332.74 29.21 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9b308efc-121c-4e9f-a636-b4a7da606663")
	)
	(text "Bring up with NO MOSFETs fitted: check 12 V and 6 V,"
		(at 332.74 35.56 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "4c4bc837-ed31-4ce3-9aa8-7af73d0b9b61")
	)
	(text "then the triangle, then both PWM outputs, then the"
		(at 332.74 39.37 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "f75d4c12-3641-4ac6-bcea-b77ec4fe0554")
	)
	(text "HIP4082 dead time on a scope.  Only then fit Q1..Q4,"
		(at 332.74 43.18 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "055f5c19-1783-4d8a-aaa6-d7cb2e266869")
	)
	(text "on a current-limited supply into a dummy load."
		(at 332.74 46.99 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "6a3c5b8b-afa5-4f70-a049-038cf8864848")
	)
	(text "C  Input stage  (level -> buffer -> inverter)"
		(at 12.7 99.06 0)
		(effects
