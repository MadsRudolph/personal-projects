				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "7c301a14-ded5-4c49-b408-cf0e1cc66f1d")
	)
	(text "AUDIO_P and AUDIO_N are equal and opposite about 6 V - that is what swings the bridge both ways."
