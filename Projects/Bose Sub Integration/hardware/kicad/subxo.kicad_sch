	(text "Bose Companion 5 sub crossover -- mono-summing 2nd-order Sallen-Key low-pass."
		(exclude_from_sim no)
		(at 30 26 0)
		(effects
			(font
				(size 2.2 2.2)
			)
			(justify left bottom)
		)
		(uuid "4ff10c8a-b3db-43ab-8810-09cce4dd63a5")
	)
	(text "Single +12 V rail, no negative supply. All AC referenced to VGND = 6 V (A3 buffers the R8/R9 mid-rail divider)."
		(exclude_from_sim no)
		(at 30 33 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "c7cac390-54f1-452d-ade9-09a3adc53df1")
	)
