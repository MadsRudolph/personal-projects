	(text "Bose Companion 5 sub crossover -- mono-summing 2nd-order Sallen-Key low-pass."
		(exclude_from_sim no)
		(at 30 26 0)
		(effects
			(font
				(size 2.2 2.2)
			)
			(justify left bottom)
		)
		(uuid "f6c63de7-5a50-4aa5-8d63-5a5db37a8c4e")
	)
	(text "Single +12 V rail, no negative supply. All AC referenced to VGND = 6 V (A3 buffers the R8/R9 mid-rail divider)."
		(exclude_from_sim no)
		(at 30 33 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "f3082ace-5490-43f8-95ca-dd254a1a3221")
	)
