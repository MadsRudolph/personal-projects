	(text "Bose Companion 5 sub crossover -- mono-summing 2nd-order Sallen-Key low-pass."
		(exclude_from_sim no)
		(at 30 26 0)
		(effects
			(font
				(size 2.2 2.2)
			)
			(justify left bottom)
		)
		(uuid "0ccb5f1d-1e1a-44f1-970c-56a2133e2664")
	)
	(text "Single +12 V rail, no negative supply. All AC referenced to VGND = 6 V (A3 buffers the R8/R9 mid-rail divider)."
		(exclude_from_sim no)
		(at 30 33 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "717bfda3-f694-45b9-a4ab-46ca4d720f0d")
	)
