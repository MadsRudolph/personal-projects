(footprint "C_Rect_L16.0mm_W7.0mm_P10.00mm"
	(version 20241229)
	(generator "hand")
	(layer "F.Cu")
	(descr "Film capacitor, 10.00mm lead pitch, body 16.0*7.0mm. Measured from the 220nF part fitted at C1_2 on the subxo sub-crossover board (leads 0.5mm, pitch 10.5mm by caliper). The body overhangs each lead by 3.0mm, which no stock P10.00mm footprint reserves -- the longest is L13.5mm. Placing this on a stock footprint under-reserves 3mm at each end and the part fouls its neighbours, which is how rev A ended up with bent leads.")
	(tags "C Rect film 10.00mm Capacitor")
