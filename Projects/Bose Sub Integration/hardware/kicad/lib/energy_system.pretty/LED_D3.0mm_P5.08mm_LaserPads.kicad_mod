(footprint "LED_D3.0mm_P5.08mm_LaserPads"
	(version 20241229)
	(generator "hand")
	(layer "F.Cu")
	(descr "3 mm through-hole LED on a widened 5.08 mm lead pitch. Every stock LED_THT two-pad footprint is 2.54 mm pitch with 1.8 mm pads, which leaves a 0.74 mm pad-to-pad gap -- below the 0.85 mm laser rule and well below the 1.2 mm a 0.8 mm endmill needs. LED legs bend freely, so the pitch is the lever to pull rather than the pad size: 5.08 mm with 2.0 mm pads gives a 3.08 mm channel that clears either process with room to spare. Pad 1 = K (cathode, square pad, flat side of the silk body), pad 2 = A. Drill 0.8 mm suits the ~0.5 mm legs and is already the commonest drill on this board.")
	(tags "LED THT 3mm 5.08mm laser mill wide clearance")
	(property "Reference" "REF**"
		(at 2.54 -3.2 0)
		(layer "F.SilkS")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
		)
	)
	(property "Value" "LED_D3.0mm_P5.08mm_LaserPads"
		(at 2.54 3.2 0)
		(layer "F.Fab")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
		)
	)
